# AI sentence chain (2026-11-14). Writers are tried in this order: NVIDIA glm, NVIDIA Nemotron, Groq, Gemini.
# NVIDIA account 1 writes (z-ai/glm-5.3-flash, then nvidia/nemotron-3-ultra-550b-a55b as backup).
NVIDIA_API_KEY=
# NVIDIA account 2 checks every item blind (minimaxai/minimax-m3.1-flash). Empty: the check uses NVIDIA_API_KEY.
NVIDIA_CHECKER_API_KEY=
# Optional model lists (comma separated) to change models without a code change:
# NVIDIA_WRITER_MODELS=z-ai/glm-5.3-flash
# NVIDIA_CHECKER_MODELS=minimaxai/minimax-m3.1-flash
# NVIDIA_TEXT_MODELS=nvidia/nemotron-3-ultra-550b-a55b
# Google Gemini (gemini-3.5-flash-lite), last before the offline bank
GEMINI_API_KEY=

# Groq Free Tier API Key (gsk_...) for openai/gpt-oss-120b (Text) & canopylabs/orpheus-v1-english (TTS)
# Supports a single key OR comma-separated keys from separate Groq accounts (e.g. gsk_key1,gsk_key2)
GROQ_API_KEY=

# Optional fallback Groq API key(s) from a second Groq account (automatically used when Key 1 hits a 429 rate limit)
GROQ_API_KEY_2=

# Optional Orpheus English TTS voice: troy (default), autumn, diana, hannah, austin, daniel
GROQ_TTS_VOICE=troy
