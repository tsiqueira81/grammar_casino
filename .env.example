# AI sentence chain: Groq qwen writes single live hands first; NVIDIA Nemotron 3.5 Super writes ahead-of-time batches first.
# NVIDIA account 1 writes (nvidia/nemotron-3.5-super-vl-120b-a12b, fallback z-ai/glm-5.3-flash, then nvidia/nemotron-3-ultra-550b-a55b).
NVIDIA_API_KEY=
# NVIDIA account 2 backup blind checker (minimaxai/minimax-m3.1-flash). Empty: uses NVIDIA_API_KEY.
NVIDIA_CHECKER_API_KEY=
# Optional model lists and writer orders (comma separated) to change models without a code change:
# NVIDIA_WRITER_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,z-ai/glm-5.3-flash
# NVIDIA_CHECKER_MODELS=minimaxai/minimax-m3.1-flash
# NVIDIA_TEXT_MODELS=nvidia/nemotron-3-ultra-550b-a55b
# AI_WRITER_ORDER=groq,nvidia-writer,nemotron,gemini
# AI_BATCH_WRITER_ORDER=nvidia-writer,groq,nemotron,gemini
# Google Gemini (gemini-3.5-flash-lite text fallback + gemini-decision-1 closed checker/grader)
GEMINI_API_KEY=
# Optional kill-switch for Gemini Decision 1 (defaults to true whenever GEMINI_API_KEY is set):
# AI_DECISION_ENABLED=true
# GEMINI_DECISION_MODEL=gemini-decision-1

# Groq Free Tier API Key (gsk_...) for openai/gpt-oss-120b (Text) & canopylabs/orpheus-v1-english (TTS)
# Supports a single key OR comma-separated keys from separate Groq accounts (e.g. gsk_key1,gsk_key2)
GROQ_API_KEY=

# Optional fallback Groq API key(s) from a second Groq account (automatically used when Key 1 hits a 429 rate limit)
GROQ_API_KEY_2=

# Optional Orpheus English TTS voice: troy (default), autumn, diana, hannah, austin, daniel
GROQ_TTS_VOICE=troy
