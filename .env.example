# AI sentence chain (2026-11-14). Writers are tried in this order: CoArena, NVIDIA, Groq, Gemini.
# On CoArena, one account writes (deepseek-v4-1-flash-1017) and a second account checks blind (glm-5-3-flash).
COARENA_WRITER_API_KEY=
COARENA_CHECKER_API_KEY=
# NVIDIA NIM (nvidia/nemotron-3-ultra-550b-a55b), second in the chain
NVIDIA_API_KEY=
# Google Gemini (gemini-3.5-flash-lite), last before the offline bank
GEMINI_API_KEY=

# Groq Free Tier API Key (gsk_...) for openai/gpt-oss-120b (Text) & canopylabs/orpheus-v1-english (TTS)
# Supports a single key OR comma-separated keys from separate Groq accounts (e.g. gsk_key1,gsk_key2)
GROQ_API_KEY=

# Optional fallback Groq API key(s) from a second Groq account (automatically used when Key 1 hits a 429 rate limit)
GROQ_API_KEY_2=

# Optional Orpheus English TTS voice: troy (default), autumn, diana, hannah, austin, daniel
GROQ_TTS_VOICE=troy
