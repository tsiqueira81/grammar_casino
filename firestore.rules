rules_version = '2';

// Grammar Casino Firestore rules.
//
// Who can do what (package A6, decision D9: the game is for any teacher):
// - Class rosters and session reports (student names and scores): each teacher who signs in
//   with a verified Google account has a private space, teachers/{their uid}/..., that only
//   they can read or write. No teacher can see another teacher's classes.
// - Cloud sentence bank: anyone can read it (it holds no personal data); only the owners
//   listed in config/owners (field "emails", a list) can add or delete sentences. That
//   document is edited in the Firebase console only; no app can read or write it.
// - The old shared rosters and session_reports collections (from before private spaces):
//   only an owner can read or delete them, so the game can copy them into the owner's space.
// - Live rooms: the teacher's screen and the students' phones sign in silently
//   (Firebase Anonymous sign-in), so each device has its own id. Only the device that
//   created a room can change or close it.
//   * rooms/{code}: the shared table (round, sentence, names and money, revealed
//     results). Anyone with the code can read it, so it never holds bets or hints.
//   * rooms/{code}/seats/{clientId}: each phone's private record (its own bet, hints,
//     power-ups, join answer). Only the host writes it, and only the phone it is
//     addressed to (its Firebase id) and the host can read it.
//   * rooms/{code}/intents/{clientId}: what each phone sends the host. Each phone can
//     write only its own, and only the host can read them.
//   So classmates can neither see nor forge each other's bets.
//
// To publish: Firebase console > Firestore Database > pick the "ai-studio-grammarcasino-..."
// database > Rules > paste this file > Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check basic string bounds
    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Any teacher signed in with Google and a verified email.
    function isGoogleTeacher() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    // The teacher whose private space this is.
    function ownsSpace(teacherId) {
      return isGoogleTeacher() && request.auth.uid == teacherId;
    }

    // An owner of the shared sentence bank (listed in config/owners).
    function isBankOwner() {
      let owners = /databases/$(database)/documents/config/owners;
      return isGoogleTeacher()
        && exists(owners)
        && request.auth.token.get('email', '') in get(owners).data.get('emails', []);
    }

    // 1. Live Classroom Multiplayer Rooms (QR Code Join & Real-Time Sync)
    match /rooms/{roomCode} {
      function isValidRoomCode() {
        return roomCode.size() >= 3 && roomCode.size() <= 12;
      }

      function isValidRoomWrite() {
        let d = request.resource.data;
        return d.keys().hasOnly(['code', 'locked', 'updatedAt', 'hostUid', 'rev', 'tableJson', 'seatRevs', 'kickedPlayerIds'])
          && d.code == roomCode
          && d.locked is bool
          && d.updatedAt is number
          && d.hostUid == request.auth.uid
          && d.rev is number
          && isBoundedString(d.tableJson, 2, 600000)
          && d.seatRevs is map
          && d.kickedPlayerIds is list;
      }

      function isRoomHost() {
        return isSignedIn() && resource.data.get('hostUid', '') == request.auth.uid;
      }

      // A room left over from an earlier class (no host recorded, or untouched for
      // 6 hours) can be taken over by a new host that happens to draw the same code.
      function isAbandonedRoom() {
        return !('hostUid' in resource.data)
          || !(resource.data.updatedAt is number)
          || resource.data.updatedAt < request.time.toMillis() - 21600000;
      }

      // The shared table: everything in it is already on every student's phone.
      allow read: if isValidRoomCode();
      allow create: if isSignedIn() && isValidRoomCode() && isValidRoomWrite();
      allow update: if isSignedIn() && isValidRoomCode() && isValidRoomWrite()
        && (isRoomHost() || isAbandonedRoom());
      allow delete: if isRoomHost();

      // Per-phone private records: that student's own bet, hints and power-ups.
      match /seats/{clientId} {
        function hostUidNow() {
          return get(/databases/$(database)/documents/rooms/$(roomCode)).data.get('hostUid', '');
        }

        // In a batch the room may be written alongside its seats, so check the room as it will be.
        function hostUidAfter() {
          return getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.get('hostUid', '');
        }

        function isValidSeatWrite() {
          let d = request.resource.data;
          return d.keys().hasOnly(['clientId', 'uid', 'playerId', 'viewJson', 'joinJson', 'kicked', 'rev', 'updatedAt'])
            && isBoundedString(clientId, 4, 80)
            && d.clientId == clientId
            && isBoundedString(d.uid, 1, 128)
            && (d.playerId == null || d.playerId is number)
            && isBoundedString(d.viewJson, 0, 200000)
            && isBoundedString(d.joinJson, 0, 5000)
            && d.kicked is bool
            && d.rev is number
            && d.updatedAt is number;
        }

        // A phone may also check a record that doesn't exist yet (before the host answers).
        allow get: if isSignedIn()
          && (resource == null || resource.data.uid == request.auth.uid || hostUidNow() == request.auth.uid);
        allow list: if false;
        allow create, update: if isSignedIn() && hostUidAfter() == request.auth.uid && isValidSeatWrite();
        allow delete: if isSignedIn() && hostUidNow() == request.auth.uid;
      }

      // Per-student intents: join requests, bets and power-ups sent to the host.
      match /intents/{clientId} {
        function isHostOfThisRoom() {
          return isSignedIn()
            && get(/databases/$(database)/documents/rooms/$(roomCode)).data.get('hostUid', '') == request.auth.uid;
        }

        function isIntentAuthor() {
          return isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
        }

        function isValidIntentWrite() {
          let d = request.resource.data;
          return isBoundedString(clientId, 4, 80)
            && d.clientId == clientId
            && d.uid == request.auth.uid
            && isBoundedString(d.type, 2, 40)
            && isBoundedString(d.payloadJson, 2, 20000)
            && d.updatedAt is number;
        }

        allow read: if isHostOfThisRoom() || isIntentAuthor();
        allow create: if isSignedIn() && isValidIntentWrite();
        // Intents written before this rule change have no uid; the first new write claims them.
        allow update: if isSignedIn() && isValidIntentWrite()
          && (isIntentAuthor() || !('uid' in resource.data));
        allow delete: if isIntentAuthor() || isHostOfThisRoom();
      }
    }

    // 2 and 3. Each teacher's private space: class rosters, session reports and resumable saves.
    match /teachers/{teacherId} {
      allow read, write: if false; // the space itself holds nothing

      function isValidRoster(rosterId) {
        let d = request.resource.data;
        return isBoundedString(rosterId, 3, 100)
          && isBoundedString(d.name, 1, 100)
          && d.startingCash is number
          && d.startingCash >= 1
          && d.startingCash <= 1000000
          && isBoundedString(d.playersJson, 2, 250000)
          && d.playerCount is number
          && d.createdAt is number
          && d.updatedAt is number;
      }

      function isValidReport(reportId) {
        let d = request.resource.data;
        return isBoundedString(reportId, 3, 100)
          && isBoundedString(d.title, 1, 160)
          && isBoundedString(d.topic, 1, 100)
          && isBoundedString(d.level, 1, 20)
          && d.roundsPlayed is number
          && d.playerCount is number
          && isBoundedString(d.playersJson, 2, 250000)
          && isBoundedString(d.roundHistoryJson, 2, 700000)
          && (!('fullGameStateJson' in d) || isBoundedString(d.fullGameStateJson, 0, 800000))
          && d.createdAt is number;
      }

      match /rosters/{rosterId} {
        allow read, delete: if ownsSpace(teacherId);
        allow create, update: if ownsSpace(teacherId) && isValidRoster(rosterId);
      }

      match /session_reports/{reportId} {
        allow read, delete: if ownsSpace(teacherId);
        allow create, update: if ownsSpace(teacherId) && isValidReport(reportId);
      }
    }

    // The old shared collections, from before private spaces: read (to copy) and delete only.
    match /rosters/{rosterId} {
      allow read, delete: if isBankOwner();
    }
    match /session_reports/{reportId} {
      allow read, delete: if isBankOwner();
    }

    // Settings such as the bank owners: changed in the Firebase console only.
    match /config/{docId} {
      allow read, write: if false;
    }

    // 4. Cloud Sentence Bank: public read, owner-only changes
    match /curated_sentences/{sentenceId} {
      allow read: if true;
      allow delete: if isBankOwner();
      allow create, update: if isBankOwner()
        && isBoundedString(sentenceId, 3, 120)
        && isBoundedString(request.resource.data.topic, 1, 100)
        && isBoundedString(request.resource.data.level, 1, 10)
        && isBoundedString(request.resource.data.questionType, 1, 30)
        && isBoundedString(request.resource.data.text, 5, 1000)
        && request.resource.data.isCorrect is bool
        && isBoundedString(request.resource.data.correction, 1, 1000)
        && isBoundedString(request.resource.data.explanation, 5, 2500)
        && request.resource.data.createdAt is number;
    }
  }
}
